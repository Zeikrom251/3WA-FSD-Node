extends layout.pug


block content
  if toast
    .toast(style="position:fixed;top:1rem;right:1rem;background:#333;color:#fff;padding:1em 2em;border-radius:5px;z-index:1000;")= toast
  .container
    h1 Jean DUPONT
    p Bienvenue sur mon portfolio
    p Contactez-moi à l'adresse email suivante :
    output#generate-email


block scripts
  script.
    (function preventSpam() {
      const b64encodedEmail = 'amVhbi5kdXBvbnRAZ21haWwuY29t';
      document.getElementById('generate-email').textContent = atob(b64encodedEmail);
    })();
    if(document.querySelector('.toast')){
      setTimeout(function(){
        document.querySelector('.toast').remove();
      }, 5000);
    }
